{
  "name": "number-guessing-game",
  "version": "1.0.0",
  "description": "A production-ready CLI Number Guessing Game built with clean architecture principles in Node.js.",
  "keywords": [
    "cli",
    "nodejs",
    "game",
    "clean-architecture",
    "backend"
  ],
  "main": "src/index.js",
  "type": "module",
  "private": true,

  "author": "Muhamed Shillua",
  "license": "ISC",

  "engines": {
    "node": ">=18.0.0"
  },

  "bin": {
    "number-guess": "./src/index.js"
  },

  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",

    "lint": "eslint src",
    "lint:fix": "eslint src --fix",

    "format": "prettier --write .",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",

    "prepare": "husky install"
  },

  "dependencies": {
    "chalk": "^5.3.0"
  },

  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "jest": "^29.7.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },

  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },

  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ]
  }
}
